{
  "name": "darwin-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Darwin live dashboard: the climbing fitness curve, leaderboard, and genome diff.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && npx wrangler@latest pages deploy dist --project-name trydarwin --branch main --commit-dirty=true",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@workos-inc/authkit-react": "^0.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
