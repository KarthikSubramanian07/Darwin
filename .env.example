# Darwin - environment. Copy to .env and fill in. Never commit .env.

# Daytona - parallel sandboxes + snapshot rollback (containment).
# Get a key: https://app.daytona.io  ->  Settings -> API Keys
DAYTONA_API_KEY=

# Braintrust - the immutable fitness function + offline eval.
# Get a key: https://www.braintrust.dev  ->  Settings -> API Keys
BRAINTRUST_API_KEY=

# Fireworks - fast, cheap, parallel inference for the mutation engine + model race.
# Get a key: https://fireworks.ai  ->  API Keys
FIREWORKS_API_KEY=
# OpenAI-compatible base URL (verified 2026-07)
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Route model inference THROUGH the Braintrust gateway so every model call in the race and
# every mutation is traced + scored in Braintrust (makes Braintrust core to inference).
# One-time setup: add your Fireworks key under Braintrust -> Settings -> AI providers.
# When on, the Fireworks key above is not needed locally (the gateway uses the one in Braintrust).
USE_BRAINTRUST_GATEWAY=1
BRAINTRUST_GATEWAY_URL=https://gateway.braintrust.dev/v1

# ---- Feature flags: set any to 0 to fall back to the offline path ----
# With ALL three at 0, the loop still runs and still CLIMBS on a canned
# task (local subprocess sandbox + local scorer + canned mutations).
FEATURE_DAYTONA=1
FEATURE_BRAINTRUST=1
FEATURE_FIREWORKS=1

# ---- Run params (demo-tuned defaults live in config.py) ----
POPULATION_SIZE=8
GENERATIONS=6
ELITE_K=2
MAX_TOTAL_SANDBOXES=48
MAX_WALL_CLOCK_S=180
RANDOM_SEED=1337
AUTO_APPROVE=1
# Demo: generation index where one deliberately-bad canary child is seeded so the
# auto-reject + rollback beat happens on stage (SPEC section 7). -1 = off.
SEED_REGRESSION_GEN=-1
