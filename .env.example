# Darwin - environment. Copy to .env and fill in. Never commit .env.

# Daytona - parallel sandboxes + snapshot rollback (containment).
# Get a key: https://app.daytona.io  ->  Settings -> API Keys
DAYTONA_API_KEY=

# Braintrust - the immutable fitness function + offline eval.
# Get a key: https://www.braintrust.dev  ->  Settings -> API Keys
BRAINTRUST_API_KEY=

# Fireworks - fast, cheap, parallel inference for the mutation engine.
# Get a key: https://fireworks.ai  ->  API Keys
FIREWORKS_API_KEY=
# OpenAI-compatible base URL (VERIFY current value in Fireworks docs)
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# CodeRabbit - independent reviewer of the code the agent writes about itself.
# The promotion gate: a champion PR is reviewed before it can be merged (human veto).
# Get a key / CLI: https://www.coderabbit.ai  (VERIFY CLI + API surface)
CODERABBIT_API_KEY=
# owner/repo the champion PRs open against (REAL path only)
GITHUB_REPO=KarthikSubramanian07/darwin

# ---- Feature flags: set any to 0 to fall back to the offline path ----
# With ALL three at 0, the loop still runs and still CLIMBS on a canned
# task (local subprocess sandbox + local scorer + canned mutations).
FEATURE_DAYTONA=1
FEATURE_BRAINTRUST=1
FEATURE_FIREWORKS=1
FEATURE_CODERABBIT=1

# ---- Run params (demo-tuned defaults live in config.py) ----
POPULATION_SIZE=8
GENERATIONS=5
ELITE_K=2
MAX_TOTAL_SANDBOXES=48
MAX_WALL_CLOCK_S=180
RANDOM_SEED=1337
AUTO_APPROVE=1
