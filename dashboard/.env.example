# Darwin dashboard (Vite) environment. Copy to `.env` and fill in. Never commit `.env`.
# Only VITE_-prefixed vars are exposed to the browser bundle. No secrets belong here.

# ---- Demo source -----------------------------------------------------------------------
# Locks the default source so the demo floor is deterministic if venue Wi-Fi fails.
#   live     = stream real events from the local pipeline over /ws
#   recorded = replay a real successful past run (SAFEST default for a live demo)
#   mock     = deterministic development data
VITE_DEMO_MODE=recorded

# Override the live event server WebSocket URL (defaults to same-origin /ws, proxied in dev).
# VITE_WS_URL=ws://localhost:8000/ws
